{
  "name": "@assalabs/design-system-example-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles/generated.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./css": "./styles/generated.css"
  },
  "sideEffects": [
    "./styles/generated.css"
  ],
  "scripts": {
    "build": "assalabs-ds tokens build && tsup src/index.ts src/native.ts --format esm --dts --clean",
    "lint": "eslint .",
    "test": "assalabs-ds tokens check",
    "tokens:build": "assalabs-ds tokens build",
    "tokens:check": "assalabs-ds tokens check",
    "typecheck": "pnpm tokens:build && tsc --noEmit"
  },
  "devDependencies": {
    "@assalabs/design-system-tools": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.8",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
