{
  "color": {
    "surface": {
      "$type": "color",
      "canvas": { "$value": "{color.primitive.neutral.950}" },
      "card": { "$value": "{color.primitive.neutral.900}" },
      "elevated": { "$value": "{color.primitive.neutral.700}" },
      "sunken": { "$value": "{color.primitive.black}" },
      "overlay": { "$value": "{color.primitive.black-alpha.60}" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "{color.primitive.white}" },
      "secondary": { "$value": "{color.primitive.neutral.300}" },
      "tertiary": { "$value": "{color.primitive.neutral.500}" },
      "inverse": { "$value": "{color.primitive.neutral.950}" },
      "link": { "$value": "{color.primitive.blue.300}" },
      "on-action": { "$value": "{color.primitive.white}" }
    },
    "icon": {
      "$type": "color",
      "primary": { "$value": "{color.primitive.white}" },
      "secondary": { "$value": "{color.primitive.neutral.300}" },
      "inverse": { "$value": "{color.primitive.neutral.950}" }
    },
    "border": {
      "$type": "color",
      "subtle": { "$value": "{color.primitive.neutral.900}" },
      "default": { "$value": "{color.primitive.neutral.500}" },
      "strong": { "$value": "{color.primitive.neutral.300}" },
      "focus": { "$value": "{color.primitive.blue.300}" }
    },
    "action": {
      "primary": {
        "$type": "color",
        "background": { "$value": "{color.primitive.blue.600}" },
        "foreground": { "$value": "{color.primitive.white}" },
        "pressed": { "$value": "{color.primitive.blue.300}" },
        "disabled-background": { "$value": "{color.primitive.neutral.700}" },
        "disabled-foreground": { "$value": "{color.primitive.neutral.500}" }
      },
      "secondary": {
        "$type": "color",
        "background": { "$value": "{color.primitive.neutral.900}" },
        "foreground": { "$value": "{color.primitive.blue.300}" },
        "pressed": { "$value": "{color.primitive.neutral.700}" }
      },
      "danger": {
        "$type": "color",
        "background": { "$value": "{color.primitive.red.600}" },
        "foreground": { "$value": "{color.primitive.white}" }
      }
    },
    "feedback": {
      "success": {
        "$type": "color",
        "background": { "$value": "{color.primitive.neutral.900}" },
        "foreground": { "$value": "{color.primitive.green.100}" }
      },
      "warning": {
        "$type": "color",
        "background": { "$value": "{color.primitive.neutral.900}" },
        "foreground": { "$value": "{color.primitive.amber.100}" }
      },
      "error": {
        "$type": "color",
        "background": { "$value": "{color.primitive.neutral.900}" },
        "foreground": { "$value": "{color.primitive.red.100}" }
      },
      "info": {
        "$type": "color",
        "background": { "$value": "{color.primitive.neutral.900}" },
        "foreground": { "$value": "{color.primitive.blue.300}" }
      }
    },
    "focus": {
      "$type": "color",
      "ring": { "$value": "{color.primitive.blue.300}" }
    }
  }
}
