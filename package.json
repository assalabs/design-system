{
  "name": "@assalabs/design-system-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:pack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "publish-packages": "changeset publish",
    "release": "pnpm build && changeset publish",
    "test": "turbo test",
    "test:pack": "node scripts/verify-design-system-pack.mjs",
    "test:consumer-parity": "node scripts/verify-consumer-parity.mjs",
    "test:template": "node scripts/verify-template.mjs",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1"
}
