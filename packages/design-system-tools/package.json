{
  "name": "@assalabs/design-system-tools",
  "version": "0.4.0",
  "description": "Standards-based design token tooling for web and React Native",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "assalabs-ds": "./bin/assalabs-ds.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --target node22 --dts --clean",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/plugin-css": "2.5.0",
    "@terrazzo/token-tools": "2.7.1",
    "chokidar": "5.0.0",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@assalabs/eslint-config": "^0.1.1",
    "@tsconfig/recommended": "^1.0.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assalabs/design-system.git",
    "directory": "packages/design-system-tools"
  },
  "homepage": "https://github.com/assalabs/design-system#readme",
  "bugs": {
    "url": "https://github.com/assalabs/design-system/issues"
  }
}
